---
import { villes } from '../../data/villesData';
import { services } from '../../data/services';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ContactSidebar from '../../components/ContactSidebar';
import FloatingActionButton from '../../components/FloatingActionButton';
import InterventionProcess from '../../components/InterventionProcess.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CheckCircle, MapPin } from 'lucide-react';

export function getStaticPaths() {
  return villes.map(ville => ({
    params: { slug: ville.slug },
    props: { ville },
  }));
}

const { ville } = Astro.props;
const otherVilles = villes.filter(v => v.id !== ville.id);
---

<Layout
  title={`${ville.title} & Île-de-France | Hygiène Protect 3D`}
  description={ville.metaDescription}
  keywords={`dératisation ${ville.city}, désinsectisation ${ville.city}, punaises de lit ${ville.city}, cafards ${ville.city}, nuisibles ${ville.city}`}
  canonical={`/villes/${ville.slug}`}
>
  <div class="min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-grow">
      <!-- Hero Section -->
      <div class="bg-gradient-to-br from-primary-50 to-blue-50 py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <Breadcrumbs items={[
            { name: 'Zones d\'intervention', url: '/villes' },
            { name: ville.city, url: `/villes/${ville.slug}` }
          ]} />

          <div class="flex items-center mb-4">
            <div class="w-16 h-16 bg-primary-100 rounded-xl flex items-center justify-center mr-4">
              <MapPin className="h-8 w-8 text-primary-600" />
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900">{ville.title}</h1>
          </div>

          <p class="text-xl text-gray-600 max-w-4xl">{ville.description}</p>
        </div>
      </div>

      <!-- Main Content -->
      <div class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
            <!-- Left Column -->
            <div class="lg:col-span-3">
              <div class="mb-12 flex justify-start">
                <img
                  src={ville.image}
                  alt={ville.imageAlt}
                  title={ville.imageTitle}
                  class="rounded-2xl shadow-xl w-full max-w-4xl h-auto object-cover"
                />
              </div>

              <div class="mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-6 text-left">
                  Notre intervention à {ville.city}
                </h2>
                <p class="text-lg text-gray-700 leading-relaxed whitespace-pre-line text-left">
                  {ville.fullDescription}
                </p>
              </div>

              <div class="mb-12 bg-blue-50 p-6 rounded-2xl">
                <h3 class="text-xl font-bold text-gray-900 mb-3">Contexte local</h3>
                <p class="text-gray-700 leading-relaxed">{ville.localContext}</p>
                {ville.neighborhoods.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-4">
                    {ville.neighborhoods.map(n => (
                      <span class="px-3 py-1 bg-white rounded-full text-sm text-gray-700 border border-primary-100">{n}</span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Services proposés dans cette ville -->
              <div class="mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-6 text-left">
                  Nos services à {ville.city}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {services.map(service => (
                    <a
                      href={`/services/${service.slug}`}
                      class="flex items-start gap-3 p-4 bg-white border border-primary-100 rounded-lg hover:shadow-md transition-shadow"
                    >
                      <CheckCircle className="h-5 w-5 text-primary-600 flex-shrink-0 mt-0.5" />
                      <span class="text-gray-700 text-sm leading-relaxed">{service.title} à {ville.city}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right Column - Sidebar -->
            <div class="lg:col-span-1">
              <div class="sticky top-24 space-y-6">
                <ContactSidebar client:load />

                <div class="bg-blue-50 p-6 rounded-2xl">
                  <h3 class="text-xl font-bold text-gray-900 mb-4">Autres villes desservies</h3>
                  <ul class="space-y-2">
                    {otherVilles.slice(0, 5).map(otherVille => (
                      <li>
                        <a
                          href={`/villes/${otherVille.slug}`}
                          class="text-primary-600 hover:text-primary-dark hover:underline transition-colors"
                        >
                          {otherVille.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <InterventionProcess />
    </main>

    <FloatingActionButton client:load />

    <Footer />
  </div>
</Layout>
