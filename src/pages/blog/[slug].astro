---
import { blogArticles } from '../../data/blogData';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ContactSidebar from '../../components/ContactSidebar';
import FloatingActionButton from '../../components/FloatingActionButton';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Calendar, ArrowLeft } from 'lucide-react';

export function getStaticPaths() {
  return blogArticles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const otherArticles = blogArticles.filter(a => a.id !== article.id).slice(0, 4);
---

<Layout
  title={`${article.title} | Blog Hygiène Protect 3D`}
  description={article.metaDescription}
  keywords={`${article.category.toLowerCase()}, ${article.title.toLowerCase()}`}
  canonical={`/blog/${article.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": article.title,
    "description": article.metaDescription,
    "image": `https://hygiene-protect-3d.fr${article.image}`,
    "datePublished": article.publishDate,
    "author": { "@type": "Organization", "name": "Hygiène Protect 3D" },
    "publisher": { "@type": "Organization", "name": "Hygiène Protect 3D" }
  })} />

  <div class="min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-grow">
      <div class="bg-gradient-to-br from-primary-50 to-blue-50 py-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <Breadcrumbs items={[
            { name: 'Blog', url: '/blog' },
            { name: article.title, url: `/blog/${article.slug}` }
          ]} />

          <a href="/blog" class="inline-flex items-center text-primary-600 hover:text-primary-dark mb-6 transition-colors">
            <ArrowLeft className="h-4 w-4 mr-2" />
            Retour au blog
          </a>

          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-primary-100 text-primary-700 mb-4">
            {article.category}
          </span>

          <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">{article.title}</h1>

          <div class="flex items-center gap-2 text-gray-500 text-sm">
            <Calendar className="w-4 h-4" />
            {new Date(article.publishDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </div>
        </div>
      </div>

      <div class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
            <div class="lg:col-span-3">
              <img
                src={article.image}
                alt={article.imageAlt}
                class="rounded-2xl shadow-xl w-full max-w-4xl h-auto object-cover mb-12"
              />

              <div class="prose max-w-none">
                {article.content.map(section => (
                  <div class="mb-10">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4 text-left">{section.heading}</h2>
                    <p class="text-lg text-gray-700 leading-relaxed text-left">{section.text}</p>
                  </div>
                ))}
              </div>

              <div class="mt-12 bg-primary-50 p-8 rounded-2xl text-center">
                <h3 class="text-2xl font-bold text-gray-900 mb-3">Besoin d'une intervention rapide ?</h3>
                <p class="text-gray-700 mb-6">Devis gratuit sous 24h, intervention 7j/7 à Paris et en Île-de-France.</p>
                <a href="tel:+33767393885" class="inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-all duration-300 shadow-lg">
                  Appeler le 07 67 39 38 85
                </a>
              </div>
            </div>

            <div class="lg:col-span-1">
              <div class="sticky top-24 space-y-6">
                <ContactSidebar client:load />

                <div class="bg-blue-50 p-6 rounded-2xl">
                  <h3 class="text-xl font-bold text-gray-900 mb-4">À lire aussi</h3>
                  <ul class="space-y-2">
                    {otherArticles.map(other => (
                      <li>
                        <a href={`/blog/${other.slug}`} class="text-primary-600 hover:text-primary-dark hover:underline transition-colors">
                          {other.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <FloatingActionButton client:load />

    <Footer />
  </div>
</Layout>
