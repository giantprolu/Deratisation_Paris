---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FloatingActionButton from '../../components/FloatingActionButton';
import { blogArticles } from '../../data/blogData';
import { ArrowRight, Calendar } from 'lucide-react';

const sorted = [...blogArticles].sort((a, b) => b.publishDate.localeCompare(a.publishDate));
---

<Layout
  title="Blog - Conseils Dératisation, Désinsectisation & Nuisibles"
  description="Conseils pratiques sur les rats, souris, cafards et punaises de lit : reconnaître une infestation, s'en débarrasser et prévenir leur retour. Blog Hygiène Protect 3D."
  canonical="/blog"
  keywords="blog dératisation, conseils punaises de lit, se débarrasser des cafards, infestation rats"
>
  <div class="min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-grow">
      <div class="bg-gradient-to-br from-primary-50 to-blue-50 py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Le Blog Hygiène Protect 3D</h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Conseils pratiques pour reconnaître, traiter et prévenir les infestations de nuisibles.
          </p>
        </div>
      </div>

      <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {sorted.map(article => (
              <a
                href={`/blog/${article.slug}`}
                class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-primary-200 hover:-translate-y-2 overflow-hidden block"
              >
                <img
                  src={article.image}
                  alt={article.imageAlt}
                  loading="lazy"
                  class="w-full h-48 object-cover"
                />
                <div class="p-6">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-primary-100 text-primary-700 mb-3">
                    {article.category}
                  </span>
                  <h2 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors duration-300 leading-tight">
                    {article.title}
                  </h2>
                  <p class="text-sm text-gray-600 mb-4 leading-relaxed">{article.excerpt}</p>
                  <div class="flex items-center justify-between text-sm">
                    <span class="flex items-center gap-1 text-gray-500">
                      <Calendar className="w-4 h-4" />
                      {new Date(article.publishDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                    </span>
                    <span class="flex items-center text-primary-600 font-medium">
                      Lire
                      <ArrowRight className="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform duration-300" />
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <FloatingActionButton client:load />

    <Footer />
  </div>
</Layout>
